{
  "name": "pvz-pinyin",
  "version": "1.1.0",
  "private": true,
  "description": "植物大战僵尸·教学版 —— 语文拼音 / 数学口算 / 英语单词 塔防学习游戏（Electron 桌面版 + Node 服务）",
  "author": "pref-mail",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "build:exe": "electron-builder --win portable"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.prefmail.pvzpinyin",
    "productName": "植物大战僵尸教学版",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "artifactName": "PVZ-Teaching-${version}-portable.${ext}",
    "files": [
      "electron/**/*",
      "public/**/*",
      "data/words.json",
      "data/english.json",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
